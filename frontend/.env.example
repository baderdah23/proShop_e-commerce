# Copy to .env and fill in your local values. Never commit .env.

# Base URL of the backend API.
#   Local development: http://localhost:8000
#   Production: set to the deployed backend URL on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (pk_test_... for test mode, pk_live_... for live).
# Publishable keys are safe to expose in the browser; the secret key must only
# ever live on the server (backend .env / Vercel environment) - never here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=