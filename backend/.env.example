# Copy to .env and fill in your local values. Never commit .env.

# Port the Express server listens on
PORT=

# Comma-separated list of allowed frontend origins
CORS_URL=

# --- Database ---
# Production (Vercel + Neon): set DATABASE_URL. When set, it overrides the
# db_* variables below and SSL is negotiated automatically.
DATABASE_URL=

# Local development database (used when DATABASE_URL is not set)
db_host=
db_port=
db_user=
db_password=
db_database=

# --- Auth ---
NODE_ENV=
# Random long secret used to sign JWT tokens. Use a fresh value in production.
JWT_SECRET=

# --- Email (nodemailer) ---
EMAIL_USER=
EMAIL_PASS=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=